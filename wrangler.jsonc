{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "playload",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kitao.dev/playload/*", "zone_name": "kitao.dev" }],
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
}
