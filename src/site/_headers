/playload/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/playload/
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval' blob: https://static.cloudflareinsights.com; worker-src blob:; style-src 'self'; font-src 'self'; connect-src https://kitao.dev/cdn-cgi/rum; img-src 'self' blob:; media-src blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/playload/assets/bundles/*
  Cache-Control: public, max-age=31536000, immutable

/playload/LICENSE
  Content-Type: text/plain; charset=utf-8
