{
  "name": "playload",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/wrangler.mjs dev --port 8765",
    "build": "node scripts/build.js",
    "examples": "node scripts/generate-examples.js",
    "examples:check": "node scripts/generate-examples.js --check",
    "screenshots": "npm run examples && node scripts/generate-screenshots.js",
    "test": "node --test \"tests/*.test.{js,mjs}\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"src/engine/glyphs.js\" --test-coverage-exclude=\"src/app/examples.js\" \"tests/*.test.{js,mjs}\"",
    "test:browser": "playwright test",
    "test:reference": "node scripts/check-sound-reference.js",
    "fonts": "node scripts/generate-glyphs.js",
    "fonts:colors": "python3 scripts/import-emoji-colors.py && npm run fonts",
    "fonts:check": "node scripts/generate-glyphs.js --check",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generated:check": "npm run fonts:check && npm run examples:check",
    "check": "npm run lint && npm run format:check && npm run generated:check && npm test && npm run test:reference && npm run test:browser",
    "deploy:check": "npm run check && node scripts/wrangler.mjs deploy --dry-run",
    "deploy": "npm run deploy:check && node scripts/wrangler.mjs deploy --strict"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "marked": "18.1.1",
    "prettier": "3.9.9",
    "prismjs": "1.30.0",
    "twitter-text": "3.1.0",
    "wrangler": "4.150.0"
  },
  "version": "0.9.1",
  "description": "A tiny game engine that lets you share games as URLs",
  "license": "MIT",
  "author": "Takashi Kitao",
  "repository": {
    "type": "git",
    "url": "https://github.com/kitao/playload.git"
  },
  "bugs": {
    "url": "https://github.com/kitao/playload/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://kitao.dev/playload/",
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
